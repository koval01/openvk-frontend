VITE_API_URL=
VITE_WS_URL=

# Media lives in the S3 bucket (Silo behind nginx, or R2 behind a CDN).
# Dev: the vite server proxies /media to the bucket so images stay same-origin.
# MEDIA_PROXY_TARGET=http://127.0.0.1:9000
# MEDIA_BUCKET=openvk
# Production: the origin browsers read media from. It is added to the CSP.
# VITE_MEDIA_ORIGIN=https://media.example.org

# Invisible always-pass dummy. Do not use …AA — that widget is a huge German “Erfolg!” test box.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
